{
  "expo": {
    "name": "CoDrive",
    "slug": "codrive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "codrive",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F3EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.codrive"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3B82F6"
      },
      "package": "com.example.codrive",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "CoDrive uses your photos so you can attach receipts and trip pictures.",
          "cameraPermission": "CoDrive uses your camera so you can snap receipts for shared expenses."
        }
      ]
    ]
  }
}
