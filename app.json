{
  "expo": {
    "name": "CoDrive",
    "slug": "codrive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "codrive",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F3EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.codrive",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3B82F6"
      },
      "package": "com.example.codrive",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "CoDrive uses your photos so you can attach receipts and trip pictures.",
          "cameraPermission": "CoDrive uses your camera so you can snap receipts for shared expenses."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "71324ca5-4a07-4b42-aa88-1aafce7ecc05"
      }
    },
    "owner": "codrive",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/71324ca5-4a07-4b42-aa88-1aafce7ecc05"
    }
  }
}
