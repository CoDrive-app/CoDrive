# Local Docker Postgres from docker-compose.yml. Render sets DATABASE_URL itself.
DATABASE_URL=postgres://codrive:codrive@localhost:5433/codrive
PORT=3000
# Maps key. Stays on the API. Never put this in the Expo app.
GEOAPIFY_API_KEY=
# Set to 1 only behind a proxy such as Render, so rate limits see each caller's address.
# TRUST_PROXY=1
